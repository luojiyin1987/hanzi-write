{
  "name": "hanzi-write",
  "version": "1.0.0",
  "description": "一个基于 Hanzi Writer 的汉字书写练习网站",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "postinstall": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "next lint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "hanzi",
    "chinese",
    "writing",
    "practice",
    "education"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luojiyin1987/hanzi-write.git"
  },
  "bugs": {
    "url": "https://github.com/luojiyin1987/hanzi-write/issues"
  },
  "homepage": "https://github.com/luojiyin1987/hanzi-write#readme",
  "dependencies": {
    "hanzi-writer": "^3.7.3",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "typescript": "^6.0.3"
  }
}
